{
  "name": "context-mesh",
  "version": "0.1.0",
  "description": "Cross-surface AI context synchronization MCP server for Brian Dawson (Stylz)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "seed": "tsx src/index.ts --seed",
    "seed:force": "tsx src/index.ts --seed --force",
    "sync": "tsx src/index.ts --sync",
    "sync:dry": "tsx src/index.ts --sync-dry",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
